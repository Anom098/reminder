# Unanchored, not `/build/`: Gradle writes to android/app/build/ as well as the
# root build/, and the anchored form silently let ~150 generated files through.
build/
coverage/

# Generated code — regenerate with `dart run build_runner build`
*.g.dart
*.freezed.dart
*.mocks.dart

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

