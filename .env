# ---------------------------------------------------------------------------
# Voice Reminder runtime configuration.
#
# This file is COMMITTED and must never contain secrets. The app is offline
# first: every value below has a safe default and the app boots correctly if
# this file is missing entirely.
#
# For machine-local overrides create `.env.local` (git-ignored) instead.
# ---------------------------------------------------------------------------

# Application identity ------------------------------------------------------
APP_NAME=Voice Reminder
APP_ENV=production

# Logging -------------------------------------------------------------------
# One of: verbose | debug | info | warning | error | nothing
LOG_LEVEL=info

# Voice parsing -------------------------------------------------------------
# Which command parser to use. `rule_based` runs fully offline. `llm` is
# reserved for a future on-device / remote model and falls back to the rule
# based parser when unavailable.
VOICE_PARSER=rule_based
# Minimum confidence (0.0-1.0) below which the app asks the user to confirm
# the parsed reminder instead of saving it silently.
VOICE_PARSER_CONFIDENCE_THRESHOLD=0.6

# Speech recognition --------------------------------------------------------
# One of: platform | whisper
SPEECH_ENGINE=platform
SPEECH_LISTEN_TIMEOUT_SECONDS=30
SPEECH_PAUSE_TIMEOUT_SECONDS=3

# Text to speech ------------------------------------------------------------
TTS_DEFAULT_LANGUAGE=en-US
TTS_DEFAULT_RATE=0.5
TTS_DEFAULT_PITCH=1.0
TTS_DEFAULT_VOLUME=1.0

# Scheduling ----------------------------------------------------------------
# How many occurrences of a repeating reminder are materialised into OS
# notification slots at a time. iOS caps an app at 64 pending notifications.
SCHEDULING_HORIZON_OCCURRENCES=12
# How often the background worker re-checks and tops up the schedule.
SCHEDULING_REFRESH_INTERVAL_HOURS=6
